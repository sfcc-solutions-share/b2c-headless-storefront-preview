<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="headlessPreviewURL">
                <display-name xml:lang="x-default">Headless Preview URL</display-name>
                <description xml:lang="x-default">URL of the headless storefront to load in the storefront toolkit (and BM "Storefront" button). Leave empty to disable.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="headlessPreviewRedirect">
                <display-name xml:lang="x-default">Headless Preview: Redirect Storefront</display-name>
                <description xml:lang="x-default">When enabled, Default-Start outside of the storefront toolkit redirects to the Headless Preview URL.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="headlessPreviewRequireBMSession">
                <display-name xml:lang="x-default">Headless Preview: Require Business Manager Session</display-name>
                <description xml:lang="x-default">Only copy preview context to the headless shopper when the request has an authenticated Business Manager session (the storefront toolkit). Recommended. When disabled, anyone who can reach the storefront can use storefront preview URL parameters to set their own shopper context.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>true</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="headlessPreviewAllowProduction">
                <display-name xml:lang="x-default">Headless Preview: Allow on Production</display-name>
                <description xml:lang="x-default">Allow headless preview on production instances. Disabled by default.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="HeadlessPreview">
                <display-name xml:lang="x-default">Headless Preview</display-name>
                <attribute attribute-id="headlessPreviewURL"/>
                <attribute attribute-id="headlessPreviewRedirect"/>
                <attribute attribute-id="headlessPreviewRequireBMSession"/>
                <attribute attribute-id="headlessPreviewAllowProduction"/>
            </attribute-group>
        </group-definitions>
    </type-extension>
</metadata>
