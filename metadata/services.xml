<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://www.demandware.com/xml/impex/services/2014-09-26">
    <!-- URL/user/password are placeholders; scripts/setup.sh writes the real values at import time -->
    <service-credential service-credential-id="headless.preview.scapi">
        <url>https://SHORT_CODE.api.commercecloud.salesforce.com/shopper/auth/v1/organizations/ORG_ID/</url>
        <user-id>SLAS_CLIENT_ID</user-id>
        <password>SLAS_CLIENT_SECRET</password>
    </service-credential>

    <service-profile service-profile-id="headless.preview">
        <timeout-millis>5000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>10</cb-calls>
        <cb-millis>1000</cb-millis>
    </service-profile>

    <service service-id="headless.preview.scapi">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>headless-preview</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>false</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>headless.preview</profile-id>
        <credential-id>headless.preview.scapi</credential-id>
    </service>
</services>
