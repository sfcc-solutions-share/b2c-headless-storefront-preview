# --- shared ---
SCAPI_SHORT_CODE=xxxxxxxx
SCAPI_ORG_ID=f_ecom_xxxx_001
SITE_ID=RefArchGlobal

# --- demo storefront (demo-server) ---
# SLAS private client for the storefront itself (default shopper scopes + sfcc.shopper-context)
SLAS_CLIENT_ID=
SLAS_CLIENT_SECRET=
PORT=3000
# hostnames (or parent domains) allowed to frame the app; narrow to your BM hostname(s)
# PREVIEW_PARENT_HOSTS=dx.commercecloud.salesforce.com,demandware.net

# --- ECOM preview service (written to the headless.preview.scapi service credential by scripts/setup.sh) ---
# SLAS private client with ONLY sfcc.ts_ext_on_behalf_of + sfcc.shopper-context.rw
PREVIEW_SLAS_CLIENT_ID=
PREVIEW_SLAS_CLIENT_SECRET=
